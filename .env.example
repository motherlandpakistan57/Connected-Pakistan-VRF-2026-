# ==============================================================================
# CONNECTED PAKISTAN — VRF 2026: ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file documents all environment variables used or supported by the application.
# Copy this template to .env.local for local development.
# NEVER commit real credentials, tokens, or private secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI STUDIO & SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# Gemini API Key (Server-side only)
# Required for Gemini AI generation and server-side model processing.
# In Google AI Studio, this is automatically injected at runtime from user secrets.
# For local full-stack execution, supply your Google AI Studio / Gemini API key.
GEMINI_API_KEY=

# Application Base URL
# The publicly accessible URL where this application is hosted (e.g., https://your-app.run.app).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for canonical links, QR code target URLs, and webhooks.
APP_URL=

# Port Configuration
# The HTTP port for the server / development runner. In the AI Studio container
# environment, this is hardcoded to 3000 and bound to 0.0.0.0.
PORT=3000

# Node Environment
# Values: 'development' | 'production' | 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE GIS & MAPS (VITE_ PREFIXED)
# ------------------------------------------------------------------------------

# Google Maps Platform API Key (Optional Client-Side)
# Used for enhanced Google Maps satellite and hybrid rendering for vendor slot
# navigation. If omitted, the applet seamlessly falls back to the embedded
# Pakistan National TopoJSON and SVG GIS zoning maps without external dependencies.
VITE_GOOGLE_MAPS_API_KEY=

